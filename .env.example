# Copy to .env and adjust. Never commit the real .env.

PLATFORM_NAME=Akademi LMS
# Public URL where students open the app (used for payment redirects)
APP_FRONTEND_URL=http://localhost:8082

# Database
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Security — at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-use-openssl-rand-base64-48
# First admin account (created on first start only)
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=change-me-please

# Demo courses and users (instruktur@lms.local / siswa@lms.local). Set false in production.
APP_SEED_DEMO=false
# Allow public sign-up as instructor
APP_ALLOW_INSTRUCTOR_SIGNUP=true

# Payments: leave MIDTRANS_SERVER_KEY empty to use the built-in simulator (development only).
# In production set the Midtrans server key, set APP_PAYMENT_SIMULATOR=false, and configure
# the Payment Notification URL in Midtrans to: https://YOUR_DOMAIN/api/payments/midtrans/notification
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false
APP_PAYMENT_SIMULATOR=false

APP_TIMEZONE=Asia/Jakarta

# Published ports
FRONTEND_PORT=8082
BACKEND_PORT=8081
POSTGRES_PORT=5434
